{
  "name": "@lucrios/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Lucrios trading bots: market data, instances, signed orders and contract transactions.",
  "license": "MIT",
  "homepage": "https://lucrios.finance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucrios-finance/sdk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-abis": "node scripts/sync-abis.mjs"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0"
  }
}
